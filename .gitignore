# User-supplied and third-party mnemonic source charts stay local unless
# redistribution permission is explicitly documented.
/assets/local-mnemonics/*
!/assets/local-mnemonics/README.md
!/assets/local-mnemonics/.gitkeep
!/assets/local-mnemonics/sources/
/assets/local-mnemonics/sources/*
!/assets/local-mnemonics/sources/README.md
!/assets/local-mnemonics/sources/.gitkeep

# Generated crops and manifests are committed so a private clone runs offline.
# The original source charts under sources/ remain local-only and ignored.
!/assets/local-mnemonics/tofugu/
!/assets/local-mnemonics/leafpiece/
!/assets/local-mnemonics/pictografix/
scripts/__pycache__/
work-*.jpg
